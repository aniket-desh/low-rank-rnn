Thumbs.db

.env

# Per-run checkpoint snapshots are large and there are many of them — they're
# regenerated by re-running with --save-every, so keep them out of git.
runs_h100/**/checkpoints/
# Blog animations (figures/blog/animations/*.mp4, *.gif) ARE committed —
# they are a few MB each and a few of them total, well under GH limits.
